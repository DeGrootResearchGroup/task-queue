# Copy this file to .env and fill in real values before running the app.

# A long random string used to sign session cookies and CSRF tokens.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

DATABASE_URL=sqlite:///./task_queue.db

# "production" enables secure (HTTPS-only) session cookies; use "development" locally.
ENVIRONMENT=development

# Owner login. Generate OWNER_PASSWORD_HASH with: uv run scripts/hash_password.py
OWNER_USERNAME=owner
OWNER_PASSWORD_HASH=

# Anti-spam
MIN_FORM_FILL_SECONDS=3.0
SUBMIT_RATE_LIMIT=5/hour

# Brute-force protection on Owner login, keyed by IP
LOGIN_RATE_LIMIT=10/minute
