# Copy this file to .env (next to docker-compose.yml) on the Linux box and
# fill in real values before running `docker compose up -d`.

# A long random string used to sign session cookies and CSRF tokens.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# Path inside the container — matches the `task_queue_data` volume mount
# in docker-compose.yml. Do not change unless you also change the volume.
DATABASE_URL=sqlite:////app/data/task_queue.db

# "production" enables secure (HTTPS-only) session cookies — required here
# since Caddy terminates HTTPS in front of this app.
ENVIRONMENT=production

# Owner login. Generate OWNER_PASSWORD_HASH by running, from this project
# on your own machine: uv run scripts/hash_password.py
# IMPORTANT: use the script's "docker compose" output (with $$ instead of $)
# here, not the plain hash — Compose's env_file loader treats a bare $ in a
# value as a variable reference and silently corrupts the hash otherwise,
# which breaks Owner login with no error at startup.
OWNER_USERNAME=owner
OWNER_PASSWORD_HASH=

# Anti-spam
MIN_FORM_FILL_SECONDS=3.0
SUBMIT_RATE_LIMIT=5/hour

# Brute-force protection on Owner login, keyed by IP
LOGIN_RATE_LIMIT=10/minute
